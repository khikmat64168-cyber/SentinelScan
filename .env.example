# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_DB=sentinelscan
POSTGRES_USER=sentinelscan
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://sentinelscan:change_me_in_production@localhost:5432/sentinelscan

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate secure values with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-char-random-hex-string-do-not-use-in-production
JWT_REFRESH_SECRET=replace-with-different-64-char-random-hex-string-do-not-use
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Docker Compose ─────────────────────────────────────────────────────────────
WEB_PORT=80
